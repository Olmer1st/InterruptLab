{
  "schemaVersion": 1,
  "id": "cancel/cooperative",
  "driver": "cooperative",
  "fixture": "sqlite",
  "seed": 42,
  "timeoutMs": 2000,
  "stepTimeoutMs": 1000,
  "cancel": {
    "at": "after-step-start",
    "operation": "slow-read",
